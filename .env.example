# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bluecollar_match?schema=public"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Email (verification + password reset). Dev mode logs links to console if unset. ---
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="BlueCollar Match <no-reply@bluecollarmatch.app>"

# --- Photo uploads (Cloudinary unsigned preset for MVP) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# --- Admin bootstrap: emails listed here get ADMIN role on sign-in ---
ADMIN_EMAILS="admin@bluecollarmatch.app"
